{
  "name": "pharmaflow",
  "private": true,
  "version": "0.0.1",
  "description": "Aplicativo de gerenciamento de fórmulas farmacêuticas.",
  "author": "Vinicius Lara",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/patch-icon.js && vite build --configLoader native && electron-builder --win",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); for (const dir of ['dist','dist-electron','release']) fs.rmSync(dir, { recursive: true, force: true });\"",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.pharmaflow.app",
    "productName": "PIX Farma",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "forceCodeSigning": false,
    "win": {
      "icon": "public/icon.ico",
      "target": [
        "dir",
        "nsis"
      ]
    }
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.18.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
