# Desktop: a conexão é configurada dentro do app e persistida em
# %APPDATA%/PharmaFlow/config.json (userData).

# Web: o servidor HTTP usa estas variáveis de ambiente.
PHARMAFLOW_WEB_PORT=3001
PHARMAFLOW_DB_HOST=localhost
PHARMAFLOW_DB_PORT=3306
PHARMAFLOW_DB_USER=root
PHARMAFLOW_DB_PASSWORD=
PHARMAFLOW_DB_DATABASE=pharmaflow
